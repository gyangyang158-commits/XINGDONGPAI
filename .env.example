# PowerShell: $env:XDP_AI_KEY_FILE='C:/your-private-folder/provider.env'
# Or set XDP_AI_KEY in the server process environment. Do not put it in HTML.
XDP_AI_MODEL=tt-6.1-sol
XDP_AI_BASE=https://api.lk888.ai/api
PORT=8772

# Optional recorded-audio transcription and local image cutout
XDP_VOICE_MODEL=gem-3.5-flash-lite
# XDP_CUTOUT_MODEL=D:/private/models/u2netp.onnx
# XDP_PYTHON=D:/your-project/.venv/Scripts/python.exe

# Use a model actually enabled for your key; match its protocol.
XDP_SCENE_VISION_MODEL=tt-6.1-sol
XDP_SCENE_VISION_FORMAT=openai

# First tea request automatically searches references; off disables external reference discovery.
XDP_REFERENCE_SEARCH=on
